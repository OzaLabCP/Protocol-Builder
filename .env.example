# Copy to .env (or export these) before running the server.
#
# The app speaks the OpenAI-compatible chat-completions protocol, so it works with any
# provider that does. Pick one with LLM_PROVIDER and give it a key. Switching providers
# later is just changing LLM_PROVIDER + LLM_API_KEY (+ LLM_MODEL) — the base URL and
# provider-specific params follow automatically.

# --- Provider A: OpenRouter (default) — one key, any model ------------------
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...                 # https://openrouter.ai/keys
# LLM_MODEL=anthropic/claude-opus-4-8
#   other examples: openai/gpt-5 · x-ai/grok-4 · google/gemini-2.5-pro · meta-llama/llama-3.3-70b-instruct

# --- Provider B: Claude API directly — use your sk-ant-… key ----------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...              # https://console.anthropic.com
# LLM_MODEL=claude-opus-4-8           # bare Anthropic id (no "anthropic/" prefix)

# Whatever the provider, the model must support tool/function calling.
# The older OPENROUTER_* names still work as aliases for LLM_* if you prefer them.

# Optional overrides (defaults shown).
# LLM_MODEL_FAST=                     # cheaper model for light phases (clarifications, discovery);
#                                       emit stays on LLM_MODEL. Empty -> same model everywhere.
# LLM_BASE_URL=                       # set only to override the provider's default endpoint
# GAPFILLER_AUTO_REVIEW=1             # 0 to disable the automatic correctness+practicality audit+fix stage
# GAPFILLER_MAX_TOKENS=16000         # base output budget per response
# GAPFILLER_MAX_TOKENS_CAP=32000     # a truncated emit auto-retries at 2x, up to this cap
#                                      (set == MAX_TOKENS to disable the auto-escalation)
# GAPFILLER_REASONING_EFFORT=high     # reasoning.effort for the heavy phases (emit/reviews/fixes); "" to omit
# GAPFILLER_REASONING_EFFORT_FAST=low # reasoning.effort for the light phases (clarifications/discovery); "" to omit
# GAPFILLER_SEND_REASONING=           # 1/0; defaults to on for openrouter, off otherwise
# GAPFILLER_REQUEST_TIMEOUT=600
# OPENROUTER_REFERER=                 # optional attribution on your OpenRouter dashboard
# OPENROUTER_TITLE=Methods Gap-Filler

# Literature grounding (all on by default except protocols.io) — run by this app, provider-agnostic.
# NCBI_API_KEY=                 # optional, higher PubMed rate limit
# GAPFILLER_ENABLE_PREPRINTS=1  # bioRxiv/medRxiv via Europe PMC
# PROTOCOLS_IO_TOKEN=           # set to enable protocols.io method grounding

# Access control (all OFF by default; turn on before any public/multi-user deployment).
# GAPFILLER_AUTH_TOKEN=         # if set, /api/* needs it (Authorization: Bearer or X-API-Key)
# GAPFILLER_RATE_LIMIT=0        # per-client requests/minute on model-driving endpoints (0 = off)
# GAPFILLER_TRUST_PROXY=0       # set 1 to read the client IP from X-Forwarded-For (only behind a proxy you control)
