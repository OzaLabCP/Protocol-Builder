# Copy to .env (or export these) before running the server.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# ANTHROPIC_MODEL=claude-opus-4-8
# GAPFILLER_SEARCH_BUDGET=12
# GAPFILLER_MAX_TOKENS=16000
# GAPFILLER_EFFORT=high

# Literature grounding (all on by default except protocols.io).
# NCBI_API_KEY=                 # optional, higher PubMed rate limit
# GAPFILLER_ENABLE_PREPRINTS=1  # bioRxiv/medRxiv via Europe PMC
# PROTOCOLS_IO_TOKEN=           # set to enable protocols.io method grounding
